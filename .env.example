# Copy to .env and fill in ONLY the values you have. Never commit .env.
# The agent runs without any of these when using the local Ollama path.

# Provider for OpenMinion: ollama (local, no key) | openai | anthropic |
# openrouter | minimax | groq | cerebras | deepseek | gemini | cortensor-portal
OPENMINION_PROVIDER=ollama

# Model id for the chosen provider (defaults are applied when empty):
#   ollama            -> llama3.2:1b
#   openai            -> gpt-4.1-mini
#   cortensor-portal  -> oss-20b
OPENMINION_MODEL=

# Hosted-provider keys — set ONLY the one for your provider.
# OpenMinion reads these from the environment; never paste a key into code.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# CORTENSOR_API_KEY=
# GROQ_API_KEY=
# MINIMAX_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
